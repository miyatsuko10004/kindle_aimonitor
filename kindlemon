#!/usr/bin/env python3
"""Start/stop the Kindle view in the background and print the URL for the Kindle."""
from pathlib import Path
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parent
PID = ROOT / '.kindle.pid'
LOG = ROOT / '.kindle.log'
PORT = 8766
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
USAGE = 'Usage: kindlemon [start|stop|status|url|install]'
KINDLE_DOCS = Path('/Volumes/Kindle/documents')


def running_pid():
    try:
        pid = int(PID.read_text())
    except (OSError, ValueError):
        return None
    out = subprocess.run(['ps', '-p', str(pid), '-o', 'args='], capture_output=True, text=True).stdout
    return pid if str(ROOT / 'kindle_server.py') in out else None


def healthy():
    try:
        with OPENER.open('http://127.0.0.1:%d/health' % PORT, timeout=1) as r:
            return r.read() == b'ok'
    except OSError:
        return False


def lan_ip():
    # No packet is sent; this only asks the OS which interface routes outward.
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        try:
            s.connect(('192.168.0.1', 9))
            return s.getsockname()[0]
        except OSError:
            return '127.0.0.1'


def url():
    token_file = ROOT / '.kindle_token'
    token = token_file.read_text().strip() if token_file.exists() else '(未生成: 先に start)'
    return 'http://%s:%d/t/%s' % (lan_ip(), PORT, token)


def start():
    if running_pid() and healthy():
        print('Already running')
    else:
        with open(LOG, 'ab') as log:
            proc = subprocess.Popen([sys.executable, str(ROOT / 'kindle_server.py'), '--port', str(PORT)],
                                    stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        PID.write_text(str(proc.pid))
        for _ in range(30):
            if healthy():
                break
            time.sleep(.1)
        else:
            print('起動を確認できません。%s を確認してください。' % LOG, file=sys.stderr)
            return 1
        print('Started')
    print('Kindleのブラウザで開くURL:\n  ' + url())
    return 0


def stop():
    pid = running_pid()
    if not pid:
        print('Not running')
        return 0
    os.kill(pid, signal.SIGTERM)
    PID.unlink(missing_ok=True)
    print('Stopped')
    return 0


def install():
    """Copy the scriptlets to a USB-connected, jailbroken Kindle with this Mac's URL filled in."""
    if not (ROOT / '.kindle_token').exists():
        print('先に kindlemon start を実行してください。', file=sys.stderr)
        return 1
    if not KINDLE_DOCS.is_dir():
        print('Kindle が見つかりません（%s）。USB で接続してください。' % KINDLE_DOCS, file=sys.stderr)
        return 1
    for src in sorted((ROOT / 'kindle').glob('*.sh')):
        text = src.read_text().replace('__URL__', url())
        # The Kindle shell needs LF line endings.
        (KINDLE_DOCS / src.name).write_bytes(text.replace('\r\n', '\n').encode())
        print('Installed: ' + src.name)
    print('Kindle を取り出してから、ライブラリの「AI Monitor - Start」をタップしてください。')
    return 0


def main(args):
    action = args[0] if args else 'start'
    if len(args) > 1 or action not in ('start', 'stop', 'status', 'url', 'install'):
        print(USAGE, file=sys.stderr)
        return 2
    if action == 'start':
        return start()
    if action == 'stop':
        return stop()
    if action == 'url':
        print(url())
        return 0
    if action == 'install':
        return install()
    ok = running_pid() and healthy()
    print(('Running: ' + url()) if ok else 'Not running')
    return 0 if ok else 1


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
